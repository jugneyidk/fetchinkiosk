<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_background"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/kioskWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/provisioningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kiosk_warning"
        android:padding="12dp"
        android:textColor="@color/kiosk_on_warning"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Development fallback" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/statusProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/state_initializing"
            android:textColor="@color/kiosk_on_background"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/kiosk_on_background"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Provisioning details" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_retry"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
