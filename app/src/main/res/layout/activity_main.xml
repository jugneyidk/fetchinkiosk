<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_background"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/kioskWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/provisioningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kiosk_warning"
        android:padding="12dp"
        android:textColor="@color/kiosk_on_warning"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Development fallback" />

    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/setup_title"
                android:textColor="@color/kiosk_on_background"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/setup_detail"
                android:textColor="@color/kiosk_on_background"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/setupStartUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:autofillHints="url"
                android:hint="@string/setup_start_url_hint"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/kiosk_on_background"
                android:textColorHint="#B8C2CC" />

            <EditText
                android:id="@+id/setupPinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:hint="@string/setup_pin_hint"
                android:inputType="numberPassword"
                android:singleLine="true"
                android:textColor="@color/kiosk_on_background"
                android:textColorHint="#B8C2CC" />

            <EditText
                android:id="@+id/setupPinConfirmInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="password"
                android:hint="@string/setup_pin_confirm_hint"
                android:inputType="numberPassword"
                android:singleLine="true"
                android:textColor="@color/kiosk_on_background"
                android:textColorHint="#B8C2CC" />

            <TextView
                android:id="@+id/setupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/kiosk_warning"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Setup error" />

            <Button
                android:id="@+id/setupSaveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/setup_save" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/statusProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/state_initializing"
            android:textColor="@color/kiosk_on_background"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/kiosk_on_background"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Provisioning details" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_retry"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/adminGestureTarget"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no" />

</FrameLayout>
